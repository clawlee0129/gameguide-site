    },
    "MONGODB_URI": {
      "description": "MongoDB connection string",
      "value": ""
    },
    "NEXT_PUBLIC_GOOGLE_ADSENSE_ID": {
      "description": "Google AdSense publisher ID",
      "value": ""
    },
    "NEXT_PUBLIC_GOOGLE_ANALYTICS_ID": {
      "description": "Google Analytics tracking ID",
      "value": ""
    }
  }
}